{
  "ScannerService": {
    "ApiPort": 58472,
    "StatusCheckInterval": 5000,
    "HttpTimeout": 2000,
    "StartupDelay": 2000,
    "DriverTimeoutMs": 15000,
    "EsclSearchTimeoutMs": 4000,
    "EsclSearchMarginMs": 2000,
    "DriverCooldownMs": 60000,
    "DriverCooldownMaxMs": 600000,
    "ScanQueueTimeoutMs": 5000,
    "ScanOverallTimeoutMs": 600000,
    "ScanNoProgressTimeoutMs": 120000,
    "ShutdownTimeoutMs": 5000,
    "ScannersRequestTimeoutSeconds": 25,
    "ScanRequestTimeoutSeconds": 660
  },
  "DatabasePath": "scanner.db",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    },
    "File": {
      "Path": "logs/scanner-.log",
      "RollingInterval": "Day",
      "RetainedFileCountLimit": 7,
      "FileSizeLimitBytes": 10485760,
      "RollOnFileSizeLimit": true
    }
  }
}