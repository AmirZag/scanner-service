<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<!-- Base version - set this ONCE and forget it. The revision part is appended automatically
		     at build time from the git commit count (e.g. 1.1.0.84 -> 1.1.0.85 on the next commit),
		     so every release gets a unique, always-increasing version with no manual numbering.
		     Bump VersionPrefix only when you want to signal a major/minor release. -->
		<VersionPrefix>1.1.0</VersionPrefix>
		<ImplicitUsings>true</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AnalysisLevel>latest</AnalysisLevel>
		<AnalysisMode>all</AnalysisMode>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<CodeAnalysisTreatWarningsAsErrors>true</CodeAnalysisTreatWarningsAsErrors>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<!-- NAPS2.Sdk 1.3.0's net10.0 assemblies carry an assembly-level RequiresPreviewFeatures mark;
		     consuming them on .NET 10 raises CA2252 unless the consuming assemblies opt in. -->
		<EnablePreviewFeatures>true</EnablePreviewFeatures>
		<NoWarn>$(NoWarn);CA1873</NoWarn>
	</PropertyGroup>

	<!-- Appends the git commit count as the file/assembly revision (1.1.0.<commitCount>).
	     Falls back to the plain VersionPrefix when git is unavailable (e.g. a zipped source tree). -->
	<Target Name="SetVersionFromGitCommitCount" BeforeTargets="PrepareForBuild">
		<Exec Command="git rev-list --count HEAD" IgnoreExitCode="true" ConsoleToMSBuild="true">
			<Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount"/>
		</Exec>
		<PropertyGroup Condition="'$(GitCommitCount)' != ''">
			<FileVersion>$(VersionPrefix).$(GitCommitCount)</FileVersion>
			<!-- The health endpoints and the OpenAPI doc read GetName().Version, which reads
			     AssemblyVersion - it must carry the revision too (assemblies are not strong-named,
			     so the per-build version does not affect assembly binding). -->
			<AssemblyVersion>$(FileVersion)</AssemblyVersion>
			<InformationalVersion>$(FileVersion)</InformationalVersion>
		</PropertyGroup>
	</Target>

	<ItemGroup Condition="'$(MSBuildProjectExtension)' != '.dcproj'">
		<PackageReference Include="SonarAnalyzer.CSharp">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
